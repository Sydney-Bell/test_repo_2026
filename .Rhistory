mutate(pred = plogis(pred))
head(leathwick_test)
leathwick_test |>
ggplot(aes(y = pred, x = Angaus_obs)) +
geom_violin() +
geom_point(position = position_jitter(width = 0.05))
leathwick_test |>
ggplot(aes(y = pred, x = factor(Angaus_obs))) +
geom_violin() +
geom_point(position = position_jitter(width = 0.05)) #add raw data points
leathwick_test <- read_csv('../data/leathwick_test.csv', trim_ws=TRUE)
glimpse(leathwick_test)
#| label: assessing accuracy
#| eval: true
#| echo: true
#use test data to assess accuracy...compare observed and predicted
head(leathwick_test)
leathwick_test <- leathwick_test |>
mutate(pred = predict(leathwick_gbm, newdata = leathwick_test, n.trees = best.iter))
head(leathwick_test)
#output is on logit scale but need them on response scale
leathwick_test <- leathwick_test |>
mutate(pred = plogis(pred))
head(leathwick_test) #now they are on the response scale!
leathwick_test |>
ggplot(aes(y = pred, x = factor(Angaus_obs))) +
geom_violin() +
geom_point(position = position_jitter(width = 0.05)) #add raw data points
#now split the dataset into 2 groups: absence and presence
pres <- leathwick_test |>
filter(Anagaus_obs == 1) |>
pull(pred)
#now split the dataset into 2 groups: absence and presence
pres <- leathwick_test |>
filter(Angaus_obs == 1) |>
pull(pred)
abs <- leathwick_test |>
filter(Angaus_obs == 0) |>
pull(pred)
#run evaluate to estimate the accuracy of our tree as a predictive machine
e <- dismo::evaluate(p = pres, a = abs)
e
leathwick_test |>
ggplot(aes(y = pred, x = factor(Angaus_obs))) +
geom_violin() +
geom_point(position = position_jitter(width = 0.05)) #add raw data points
#| label: spatial data
#| eval: true
#| echo: true
data("Anguilla_grids")
plot(Anguilla_grids)
#can predict in space now
fit <- predict(Anguilla_grids, leathwick.gbm,
n.trees = best.iter, type = "response")
#can predict in space now
fit <- predict(Anguilla_grids, leathwick_gbm,
n.trees = best.iter, type = "response")
plot(fit)
#pretty plot
install.packages("stars")
library(stars)
#convert fit to stars object
fit <- stars::st_as_stars(fit)
ggplot() +
geom_stars(data = fit) +
scale_fill_gradient(low = "red", high = "green", "Probability\nof occurance",
na.value = NA) +
coord_sf(expand = FALSE) +
theme_bw()
