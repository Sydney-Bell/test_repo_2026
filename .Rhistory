library(gbm)         #for gradient boosted models
library(car)
library(dismo)
library(pdp)
library(ggfortify)
library(randomForest)
library(tidyverse)
library(gridExtra)
library(patchwork)
library(easystats)
leathwick <- read_csv('../data/leathwick.csv', trim_ws=TRUE)
glimpse(leathwick)
leathwick_test <- read_csv('../data/leathwick_test.csv', trim_ws=TRUE)
glimpse(leathwick_test)
#| label: scatterplot
#| eval: true
#| echo: true
scatterplotMatrix(~Angaus + SegSumT + SegTSeas + SegLowFlow + DSDist +
DSMaxSlope + DSDam + USAvgT + USRainDays + USSlope +
USNative + LocSed,
data = leathwick,
diagonal = list(method = "boxplot"))
#| label: scatterplot
#| eval: true
#| echo: true
scatterplotMatrix(~Angaus + SegSumT + SegTSeas + SegLowFlow + DSDist +
DSMaxSlope + DSDam + USAvgT + USRainDays + USSlope +
USNative + LocSed,
data = leathwick,
diagonal = list(method = "boxplot")) |>
suppressWarnings()
#| label: regression tree
#| eval: true
#| echo: true
leathwick_gbm <- gbm(Angaus ~ SegSumT + SegTSeas + SegLowFlow + DSDist +
DSMaxSlope + DSDam + USAvgT + USRainDays + USSlope +
USNative + LocSed,
data = leathwick,
distribution = "bernoulli", #loss function
n.trees = 10000, #a good starting point
var.monotone = c(1, 1, 0, -1, -1, 0, 1, -1, -1, -1, -1), #monotonic trends
interaction.depth = 5, #how many splits does each tree have (typically 5, 7, or 9)
shrinkage = 0.001, #learning rate, only going to retain 1% in memory
bag.fraction = 0.5, #50% of data are in and 50% are out for testing at tree level
train.fraction = 1, #determines how much is completely withheld and never seen by the model for training (1 = none withheld)
n.minobsinnode = 10, #node cannot have less than 10 data points
cv.folds = 10 #how many times should each tree be repeated
)
(best.iter <- gbm::gbm.perf(newman_gbm, method = 'cv'))
summary(leathwick_gbm, n.trees = best.iter)
100/11
summary(leathwick_gbm, n.trees = best.iter)
#| label: partial plots
#| eval: true
#| echo: true
attr(leathwick_gbm$Terms, "term.labels")
plot(leathwick_gbm, 1, n.tree = best.iter)
#| label: partial plots
#| eval: true
#| echo: true
attr(leathwick_gbm$Terms, "term.labels")
#a nicer way to plot these
leathwick_gbm |>
pdp::partial(pred.var = 'SegSumT',
n.trees = best.iter,
type = "regression",
recursive = FALSE,
ice = TRUE,
inv.link = exp) |>
autoplot()
#a nicer way to plot these
leathwick_gbm |>
pdp::partial(pred.var = 'SegSumT',
n.trees = best.iter,
type = "regression",
recursive = FALSE,
ice = TRUE,
inv.link = exp) |>
autoplot()
#a nicer way to plot these
