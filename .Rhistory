type = "regression",
recursive = FALSE,
#ice = TRUE,
inv.link = exp) |>
autoplot()
#a nicer way to plot these
leathwick_gbm |>
pdp::partial(pred.var = 'SegSumT',
n.trees = best.iter,
type = "regression",
recursive = FALSE,
#ice = TRUE,
