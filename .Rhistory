epred_draws(hughes_brm2, newdata = newdata, re_formula = NA) |>
#filter(.draw == 1, HABITAT == "C", SECTOR == "North") |>
mutate(bleaching = as.numeric(as.character(.category))) |>
mutate(score = .epred * bleaching) |>
ungroup() |>
group_by(HABITAT, SECTOR, .draw) |>
summarise(score = sum(score)) |>
summarise_draws(median, HDInterval::hdi)
#| label: comparisons
#| eval: true
#| echo: true
cellmeans <- epred_draws(hughes_brm2, newdata = newdata, re_formula = NA) |>
#filter(.draw == 1, HABITAT == "C", SECTOR == "North") |>
mutate(bleaching = as.numeric(as.character(.category))) |>
mutate(score = .epred * bleaching) |>
ungroup() |>
group_by(HABITAT, SECTOR, .draw) |>
summarise(score = sum(score))
cellmeans |>
compare_levels(var = score, by = HABITAT, comparison = emmeans_comparison("pairwise"))
cellmeans |>
compare_levels(var = score, by = HABITAT, comparison = emmeans_comparison("pairwise")) |>
summarise_draws(median, HDInterval::hdi, Pl = ~mean(.x < 0), Pg = ~mean(.x > 0))
#| label: fractional scale table
#| eval: true
#| echo: true
cellmeans |>
mutate(lscore = log(score)) |>
compare_levels(var = lscore, by = HABITAT, comparison = emmeans_comparison("pairwise")) |>
mutate(score = exp(lscore)) |>
summarise_draws(median, HDInterval::hdi, Pl = ~mean(.x < 1), Pg = ~mean(.x > 1))
#| label: setup
#| include: false
#| cache: false
knitr::opts_chunk$set(cache.lazy = FALSE,
tidy = "styler")
options(tinytex.engine = "xelatex")
#| label: libraries
#| output: false
#| eval: true
#| warning: false
#| message: false
#| cache: false
library(tidyverse) #for data wrangling
library(car)       #for regression diagnostics
library(broom)     #for tidy output
library(ggfortify) #for model diagnostics
library(knitr)     #for kable
library(emmeans)   #for estimating marginal means
library(MASS)      #for glm.nb
library(brms)
library(broom.mixed)
library(tidybayes)
library(bayesplot)
library(standist)   #for visualizing distributions
library(cmdstanr)   #for cmdstan
library(ggeffects)
library(rstan)
library(DHARMa)
library(ggridges)
library(easystats)     #framework for stats, modelling and visualisation
library(patchwork)
source('helperFunctions.R')
#| label: readData
copper <- read_csv("../data/copper.csv", trim_ws = TRUE)
View(copper)
glimpse(copper)
#| label: set factors
#| eval: true
#| echo: true
#in this case, we want DIST to be categorical because if continuous youd have to fit a straight line and that would assume linearity, also want to compare different distances, AND we dont know what the actual distances are. If we had 20 distances, then you'd probably make it continuous
copper <- copper |>
mutate(COPPER = factor(COPPER),
PLATE = factor(PLATE),
DIST = factor(DIST),
AREA = 4,
COUNT = WORMS * AREA) #creating this variable because we know the areas were all 4
#| label: boxplot
#| eval: true
#| echo: true
#categorical variables = boxplot or violin plot
copper |> ggplot(aes(y = WORMS, x = DIST, fill = COPPER)) +
geom_violin()
#| label: boxplot
#| eval: true
#| echo: true
#categorical variables = boxplot or violin plot
copper |> ggplot(aes(y = WORMS, x = DIST, fill = COPPER)) +
geom_boxplot()
copper |> ggplot(aes(y = WORMS, x = DIST, fill = COPPER)) +
geom_boxplot() +
facet_wrap(~ PLATE)
copper |> ggplot(aes(y = WORMS, x = DIST, fill = COPPER)) +
geom_point() +
facet_wrap(~ PLATE)
copper |> ggplot(aes(y = WORMS, x = DIST, fill = COPPER)) +
geom_point() +
facet_wrap(~ COPPER+PLATE)
#| label: fit bayesian model
#| eval: true
#| echo: true
#the offset also needs to be on a log scale since that is the link function here
copper_form <- bf(COUNT ~ COPPER*DIST + (1 | PLATE) + offset(log(AREA)) , family = poisson(link = "log"))
#get priors
get_prior(copper_form, data = copper)
#intercept is the average number of counts per area (density) in control plates at distance 1
#get average
copper |> group_by(COPPER, DIST) |>
summarise(Median = median(log(WORMS + 0.5)), MAD = mad(log(WORMS + 0.5)))
#set priors
priors <- prior(normal(2.4, 0.2), class = "Intercept") +
prior(normal(0, 3), class = "b")
copper_brm1 <- brm(copper_form,
data=copper,
prior=priors,
sample_prior="only",
iter=5000,
chains=3, cores=3, #one core per chain
warmup=1000,
thin=5,
backend="cmdstanr",
refresh=0,
seed = 1,
control = list(adapt_delta = 0.99))
copper_brm1 <- brm(copper_form,
data=copper,
prior=priors,
sample_prior="only",
iter=5000,
chains=3, cores=3, #one core per chain
warmup=1000,
thin=5,
backend="cmdstanr",
refresh=0,
seed = 1,
control = list(adapt_delta = 0.99))
#| label: refit with data
#| eval: true
#| echo: true
copper_brm2 <- update(copper_brm1,
sample_prior = "yes",
control = list(adapt_delta = 0.99),
seed = 1,
refresh = 0)
copper_brm2 |>
conditonal_effects("COPPER:DIST") |>
plot(points = TRUE)
copper_brm2 |>
conditional_effects("COPPER:DIST") |>
plot(points = TRUE)
#| label: diagnostics
#| eval: true
#| echo: true
copper_brm2$fit |> stan_trace(inc_warmup = TRUE)
#have over 10 trace plots so need to cut them down so we can see them
get_variables(copper_brm2)
params <- get_variables(copper_brm2) |> str_subset("^b_.*|^sd_.*")
params
#now do this
copper_brm2$fit |> stan_trace(pars = params)
#now do this
copper_brm2$fit |> stan_trace(pars = params)
copper_brm2$fit |> stan_ac(pars = params)
copper_brm2$fit |> stan_rhat()
copper_brm2$fit |> stan_ess()
copper_brm2 |> pp_check(type = 'dens_overlay', ndraws=100)
hughes.resids <- make_brms_dharma_res(copper_brm2, integerResponse = TRUE)
copper.resids <- make_brms_dharma_res(copper_brm2, integerResponse = TRUE)
testUniformity(hughes.resids)
plotResiduals(hughes.resids, quantreg = FALSE, asFactor = FALSE)
testDispersion(hughes.resids)
#| label: diagnostics
#| eval: true
#| echo: true
copper_brm2 |> SUYR_prior_and_posterior()
copper_brm2 |>
conditional_effects("COPPER:DIST", conditions = list(AREA = 4))
#| label: summary table
#| eval: true
#| echo: true
copper_brm2 |>
as_draws_df() |>
dplyr::select(matches("^b_.*|^sd_.*")) |>
mutate(across(matches("^b_.*"), exp)) |>
summarise_draws(median,
HDInterval::hdi,
rhat,
ess_bulk,
Pl = ~mean(.x < 1), #less than
Pg = ~mean(.x > 1)) #greater than
#b_Intercept = average density of 10.6 worms in the control group at distance = 1
#b_COPPERWeek1 = difference between control and Week1 groups at distance = 1. Density is 10.8*0.67 in Week1
10.8*0.67
#| label: summary table
#| eval: true
#| echo: true
#in log scale so we want to exp
copper_brm2 |>
as_draws_df() |>
dplyr::select(matches("^b_.*|^sd_.*")) |>
mutate(across(matches("^b_.*"), exp)) |>
summarise_draws(median,
HDInterval::hdi,
rhat,
ess_bulk,
Pl = ~mean(.x < 1), #less than
Pg = ~mean(.x > 1)) #greater than
#can do this to get density (although it still says counts)
copper_brm2 |>
conditional_effects("COPPER:DIST", conditions = list(AREA = 1))
#| label: split up interactions further
#| eval: true
#| echo: true
copper_brm2 |>
emmeans(~COPPER, type = "response")
#| label: split up interactions further
#| eval: true
#| echo: true
copper_brm2 |>
emmeans(~COPPER | DIST, type = "response")
copper_brm2 |>
emmeans(~DIST | COPPER, type = "response")
#| label: split up interactions further
#| eval: true
#| echo: true
#COPPER means conditional on DIST
copper_brm2 |>
emmeans(~COPPER | DIST, type = "response")
#now want to look at comparisons
copper_brm2 |>
emmeans(~COPPER | DIST, type = "response") |>
pairs()
#| label: setup
#| include: false
#| cache: false
knitr::opts_chunk$set(cache.lazy = FALSE,
tidy = "styler")
options(tinytex.engine = "xelatex")
#| label: libraries
#| output: false
#| eval: true
#| warning: false
#| message: false
#| cache: false
library(broom)     #for tidy output
library(knitr)     #for kable
library(effects)   #for partial effects plots
library(emmeans)   #for estimating marginal means
library(MASS)      #for glm.nb
library(tidyverse) #for data wrangling
library(brms)
library(tidybayes)
library(bayesplot)
library(broom.mixed)
library(rstan)
library(patchwork)
library(DHARMa)
source('helperFunctions.R')
ltmp <- read_csv('../data/ltmp.csv', trim_ws=TRUE)
glimpse(ltmp)
#| label: data prep
#| eval: true
#| echo: true
#categorical variables and filter to just one reef
ltmp_sub <- ltmp |>
dplyr::filter(AIMS_REEF_NAME == "Agincourt Reef No.1") |>
droplevels() |> #need to remove factors/levels that aren't included in Agincourt Reef No.1
mutate(SITE = factor(paste(AIMS_REEF_NAME, SITE_NO)),
TRANSECT_NO = factor(paste(SITE, TRANSECT_NO)),
fYEAR = REPORT_YEAR)
ltmp_sub
#| label: data prep
#| eval: true
#| echo: true
#categorical variables and filter to just one reef
ltmp_sub <- ltmp |>
dplyr::filter(AIMS_REEF_NAME == "Agincourt Reef No.1") |>
droplevels() |> #need to remove factors/levels that aren't included in Agincourt Reef No.1
mutate(SITE = factor(paste(AIMS_REEF_NAME, SITE_NO)),
TRANSECT_NO = factor(paste(SITE, TRANSECT_NO)),
fYEAR = factor(REPORT_YEAR))
ltmp_sub
#| label: data prep
#| eval: true
#| echo: true
#categorical variables and filter to just one reef
ltmp_sub <- ltmp |>
dplyr::filter(AIMS_REEF_NAME == "Agincourt Reef No.1") |>
droplevels() |> #need to remove factors/levels that aren't included in Agincourt Reef No.1
mutate(SITE_NO = factor(paste(AIMS_REEF_NAME, SITE_NO)),
TRANSECT_NO = factor(paste(SITE, TRANSECT_NO)),
fYEAR = factor(REPORT_YEAR))
#| label: data prep
#| eval: true
#| echo: true
#categorical variables and filter to just one reef
ltmp_sub <- ltmp |>
dplyr::filter(AIMS_REEF_NAME == "Agincourt Reef No.1") |>
droplevels() |> #need to remove factors/levels that aren't included in Agincourt Reef No.1
mutate(SITE_NO = factor(paste(AIMS_REEF_NAME, SITE_NO)),
TRANSECT_NO = factor(paste(SITE_NO, TRANSECT_NO)),
fYEAR = factor(REPORT_YEAR))
ltmp_sub
#| label: visualize data
#| eval: true
#| echo: true
ltmp_sub |>
ggplot(aes(y = HC, x = REPORT_YEAR)) +
geom_line(aes(group = TRANSECT_NO, colour = SITE_NO)) +
geom_point()
#| label: model formula
#| eval: true
#| echo: true
#treat YEAR as categorical
#The intercept would be the first year (1995) but this first year had less photos and wonky data
#so lets change the intercept
ltmp_sub <- ltmp_sub |>
mutate(fYEAR = factor(fYEAR, levels = rev(levels(fYEAR))))
ltmp_sub_form <- bf(n.point | trials(total.points) ~ fYEAR + (1|SITE_NO) + (1|TRANSECT_NO),
family = binomial(link = "logit"))
#writing the formula this way has transect nested within site
ltmp_sub_form <- bf(n.points | trials(total.points) ~ fYEAR + (1|SITE_NO) + (1|TRANSECT_NO),
family = binomial(link = "logit"))
#| label: priors
#| eval: true
#| echo: true
get_prior(ltmp_sub_form, data = ltmp_sub)
#intercept is the average HC at 2023
ltmp_sub |> group_by(fYEAR) |>
summarise(Median = median(log(HC + 0.5)), MAD = mad(log(HC + 0.5)))
#intercept is the average HC at 2023
ltmp_sub |> group_by(fYEAR) |>
summarise(Median = median(log(HC/100)), MAD = mad(log(HC/100)))
#intercept is the average HC at 2023
ltmp_sub |> group_by(fYEAR) |>
summarise(Median = median(plogis(HC/100)), MAD = mad(plogis(HC/100)))
#intercept is the average HC at 2023
ltmp_sub |> group_by(fYEAR) |>
summarise(Median = median(qlogis(HC/100)), MAD = mad(qlogis(HC/100)))
#set priors
priors <- prior(normal(-0.8, 0.3), class = "Intercept") +
prior(normal(0, 3), class = "b")
#set priors
priors <- prior(normal(-0.8, 0.3), class = "Intercept") +
prior(normal(0, 3), class = "b") +
prior(student_t(3, 0, 0.5), class = "sd")
#| label: run model
#| eval: true
#| echo: true
ltmp_sub_brm1 <- brm(ltmp_sub_form,
data=ltmp_sub,
prior=priors,
sample_prior="only",
iter=5000,
chains=3, cores=3, #one core per chain
warmup=1000,
thin=5,
backend="cmdstanr",
refresh=0,
seed = 1,
control = list(adapt_delta = 0.99))
ltmp_sub_brm1 |>
conditional_effects(conditions = data.frame(total.points = 200)) |>
plot(points = TRUE)
#| label: run model with data
#| eval: true
#| echo: true
ltmp_sub_brm2 <- update(ltmp_sub_brm1,
sample_prior = "yes",
chains = 3, cores = 3,
control = list(adapt_delta = 0.99, max_treedepth = 20),
seed = 1,
refresh = 100)
ltmp_sub_brm2 |>
conditional_effects(conditions = data.frame(total.points = 200)) |>
plot(points = TRUE)
#| label: diagnostics
#| eval: true
#| echo: true
ltmp_sub_brm2 |> SUYR_prior_and_posterior()
#| label: diagnostics
#| eval: true
#| echo: true
ltmp_sub_brm2$fit |> stan_trace(inc_warmup = TRUE)
#have over 10 trace plots so need to cut them down so we can see them
get_variables(ltmp_sub_brm2)
params <- get_variables(ltmp_sub_brm2) |> str_subset("^b_.*|^sd_.*")
params
#now do this
ltmp_sub_brm2$fit |> stan_trace(pars = params)
ltmp_sub_brm2$fit |> stan_ac(pars = params)
ltmp_sub_brm2$fit |> stan_rhat()
ltmp_sub_brm2$fit |> stan_ess()
ltmp_sub_brm2 |> pp_check(type = 'dens_overlay', ndraws=100)
ltmp.resids <- make_brms_dharma_res(ltmp_sub_brm2, integerResponse = TRUE)
testUniformity(ltmp.resids)
plotResiduals(ltmp.resids, quantreg = FALSE, asFactor = FALSE)
testDispersion(ltmp.resids)
#nothing super obviously wrong
#have over 10 trace plots so need to cut them down so we can see them
get_variables(ltmp_sub_brm2)
ltmp_sub_brm2$fit |> stan_trace(pars = params)
ltmp_sub_brm2$fit |> stan_ac(pars = params)
ltmp_sub_brm2$fit |> stan_rhat()
ltmp_sub_brm2$fit |> stan_ess()
ltmp_sub_brm2 |> pp_check(type = 'dens_overlay', ndraws=100)
ltmp.resids <- make_brms_dharma_res(ltmp_sub_brm2, integerResponse = TRUE)
testUniformity(ltmp.resids)
plotResiduals(ltmp.resids, quantreg = FALSE, asFactor = FALSE)
testDispersion(ltmp.resids)
#| label: diagnostics
#| eval: true
#| echo: true
ltmp_sub_brm2 |>
hypothesis("fYEAR2021=0") |>
plot()
#| label: summary
#| eval: true
#| echo: true
#not really needed because we are just interested in trends
#but we will look and see where the most variation is
ltmp_sub_brm2 |> summary()
