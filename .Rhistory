#| eval: true
#| echo: true
#absolute scale
tobacco_brm3 |>
as_draws_df() |>
dplyr::select("^b_.*|^sigma$|^sd_.*") |>
summarise_draws(median,
HDInterval::hdi,
rhat,
ess_bulk,
Pl = ~mean(.x < 0), #less than
Pg = ~mean(.x > 0)) #greater than
#| label: summary table
#| eval: true
#| echo: true
#absolute scale
tobacco_brm3 |>
as_draws_df() |>
dplyr::select(matches("^b_.*|^sigma$|^sd_.*")) |>
summarise_draws(median,
