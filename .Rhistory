wq_form <- bf(NOx | cens(NOx_flag) ~
s(dt_num, by = Season), family = Gamma(link = "log"))
priors <- prior(normal(-3.1, 1), class = "Intercept") +
prior(normal(0, 5), class = "b") +
prior(student_t(3, 0, 5), class = 'sds') +
prior(gamma(0.01, 0.01), class = 'shape')
wq_sub_brm4 <- brm(wq_form,
data = wq_sub,
prior = priors,
sample_prior = 'yes',
iter = 5000,
warmup = 1500,
chains = 3, cores = 3,
thin = 5,
refresh = 0,
control = list(adapt_delta = 0.99, max_treedepth = 20),
backend = "cmdstanr",
seed = 123
)
wq_sub_brm4 |>
conditional_effects(effects = "dt_num:Season") |>
plot(points = TRUE) |>
_[[1]] +
scale_y_log10() +
geom_point(data = wq_sub, inherit.aes = FALSE,
aes(y = NOx, x = dt_num, color = Season))
priors <- prior(normal(-3.1, 1), class = "Intercept") +
prior(gamma(0.01, 0.01), class = 'shape') +
prior(inv_gamma(4.6, 0.4), class = 'lscale', coef = "gpdt_numSeasonDry") +
prior(inv_gamma(4.6, 0.4), class = 'lscale', coef = "gpdt_numSeasonWet") +
prior(student_t(3, 0, 1), class = "sdgp") #this is the amplitude --> how much the blue line is allowed to wobble
