filter(.draw == 1)
x |>
filter(.draw == 1) |>
ungroup() |>
group_by(.draw)
x |>
filter(.draw == 1) |>
ungroup() |>
group_by(.draw, Season)
x |>
filter(.draw == 1) |>
ungroup() |>
group_by(.draw, Season) |>
summarise(i = which.max(.epred), dt = dt_num[i], NOx = NOx[i])
x |>
filter(.draw == 1) |>
ungroup() |>
group_by(.draw, Season) |>
summarise(i = which.max(.epred), dt = dt_num[i], NOx = .epred[i])
x |>
#filter(.draw == 1) |>
ungroup() |>
group_by(.draw, Season) |>
summarise(i = which.max(.epred), dt = dt_num[i], NOx = .epred[i])
x |>
#filter(.draw == 1) |>
ungroup() |>
group_by(.draw, Season) |>
summarise(i = which.max(.epred), dt = dt_num[i], NOx = .epred[i]) |>
dplyr::select(-i) |>
summarise_draws(median, HDInterval::hdi)
x |>
#filter(.draw == 1) |>
ungroup() |>
group_by(.draw, Season) |>
summarise(i = which.max(.epred), dt = dt_num[i], NOx = .epred[i]) |>
dplyr::select(-i) |>
group_by(Season) |>
summarise_draws(median, HDInterval::hdi)
#now get nicer looking dates
x |>
ungroup() |>
group_by(.draw, Season) |>
summarise(i = which.max(.epred), dt = dt_num[i], NOx = .epred[i]) |>
dplyr::select(-i) |>
group_by(Season) |>
dplyr::select(-NOx) |>
summarise_draws(median, HDInterval::hdi) |>
mutate(across(c(median, lower, upper), lubridate::date_decimal))
