##### Sample prior and posterior



#### Gaussian process

##### Model formula
```{r}
#| label: gp formula
#| eval: true
#| echo: true

wq_form <- bf(NOx | cens(NOx_flag) ~
                gp(dt_num), family = Gamma(link = "log"))

```

##### Priors
```{r}
#| label: priors gp
#| eval: true
#| echo: true

invgamma_from_weak_distance(
  lower_distance = 0.10,
  upper_distance = 0.5,
  weak_correlation = 0.10,
  probability = 0.90) #strongly believe (90%) that correlation will deteriorate to 0.1 somewhere between 0.1 and 0.5 on the x axis

standist::visualize("inv_gamma(4.6, 0.4)", xlim = c(0,2))

priors <- prior(normal(-3.1, 1), class = "Intercept") +
  prior(gamma(0.01, 0.01), class = 'shape') +
  prior(inv_gamma(4.6, 0.4), class = 'lscale', coef = "gpdt_num") +
  prior(student_t(3, 0, 1), class = "sdgp") #this is the amplitude --> how much the blue line is allowed to wobble
```
##### Sample prior only

```{r}
#| label: model prior only
#| eval: true
#| echo: true

wq_sub_brm2b <- brm(wq_form,
                  data = wq_sub,
                  prior = priors,
                  sample_prior = 'only',
                  iter = 5000,
                  warmup = 1500,
                  chains = 3, cores = 3,
                  thin = 5,
                  refresh = 100,
                  control = list(adapt_delta = 0.99, max_treedepth = 20),
                  backend = "cmdstanr",
                  seed = 123
                  )
#increase warmup if getting too many transitions ending with divergence
```



##### Sample prior and posterior
```{r}
#| label: model with data
#| eval: true
#| echo: true

wq_sub_brm2c <- update(wq_sub_brm2b,
                  sample_prior = 'yes',
                  chains = 3, cores = 3,
                  refresh = 0,
                  seed = 123
                  )
```

:::::

### Plotting prior and posterior
```{r}
#| label: conditional effects plot
#| eval: true
#| echo: true

wq_sub_brm2c |> 
  conditional_effects() |> 
  plot(points = TRUE) |> 
  _[[1]] +
  geom_point(data = wq_sub, inherit.aes = FALSE,
             aes(y = NOx, x = dt_num))
```
::::
