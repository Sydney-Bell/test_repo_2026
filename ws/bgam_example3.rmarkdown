# Model investigation


# Explore more models
```{r}
#| label: including season in the model
#| eval: true
#| echo: true

wq_form <- bf(NOx | cens(NOx_flag) ~
                s(dt_num, by = Season), family = Gamma(link = "log"))

priors <- prior(normal(-3.1, 1), class = "Intercept") +
  prior(normal(0, 5), class = "b") +
  prior(student_t(3, 0, 5), class = 'sds') +
  prior(gamma(0.01, 0.01), class = 'shape')

wq_sub_brm4 <- brm(wq_form,
                  data = wq_sub,
                  prior = priors,
                  sample_prior = 'yes',
                  iter = 5000,
                  warmup = 1500,
                  chains = 3, cores = 3,
                  thin = 5,
                  refresh = 0,
                  control = list(adapt_delta = 0.99, max_treedepth = 20),
                  backend = "cmdstanr",
                  seed = 123
                  )

wq_sub_brm4 |> 
  conditional_effects(effects = "dt_num:Season") |> 
  plot(points = TRUE) |> 
  _[[1]] +
  scale_y_log10() +
  geom_point(data = wq_sub, inherit.aes = FALSE,
             aes(y = NOx, x = dt_num, color = Season))
```

# Gaussian process model w Seasons
```{r}
#| label: gp w seasons
#| eval: true
#| echo: true

wq_form <- bf(NOx | cens(NOx_flag) ~
                gp(dt_num, by = Season), family = Gamma(link = "log"))

invgamma_from_weak_distance(
  lower_distance = 0.10,
  upper_distance = 0.5,
  weak_correlation = 0.10,
  probability = 0.90) #strongly believe (90%) that correlation will deteriorate to 0.1 somewhere between 0.1 and 0.5 on the x axis

get_prior(wq_form, data = wq_sub)

standist::visualize("inv_gamma(4.6, 0.4)", xlim = c(0,2))

priors <- prior(normal(-3.1, 1), class = "Intercept") +
  prior(gamma(0.01, 0.01), class = 'shape') +
  prior(inv_gamma(4.6, 0.4), class = 'lscale', coef = "gpdt_numSeasonDry") +
  prior(inv_gamma(4.6, 0.4), class = 'lscale', coef = "gpdt_numSeasonWet") +
  prior(student_t(3, 0, 1), class = "sdgp") #this is the amplitude --> how much the blue line is allowed to wobble

wq_sub_brm5 <- brm(wq_form,
                  data = wq_sub,
                  prior = priors,
                  sample_prior = 'yes',
                  iter = 5000,
                  warmup = 1500,
                  chains = 3, cores = 3,
                  thin = 5,
                  refresh = 0,
                  control = list(adapt_delta = 0.99, max_treedepth = 20),
                  backend = "cmdstanr",
                  seed = 123
                  )

wq_sub_brm5 |> 
  conditional_effects(effects = "dt_num:Season") |> 
  plot(points = TRUE) |> 
  _[[1]] +
  #scale_y_log10() +
  geom_point(data = wq_sub, inherit.aes = FALSE,
             aes(y = NOx, x = dt_num, color = Season))
```
```{r}
#| label: now find out when the peaks occured
#| eval: true
#| echo: true

#create data --> predictions on the line and find which one is the highest value
newdata <- data.frame(dt_num = seq(2010, 2017, len = 1000)) |> 
  crossing(Season = c("Wet", "Dry"))
head(newdata)

x <- wq_sub_brm5 |> 
  epred_draws(newdata = newdata, ndraws = 100)

x |> 
  #filter(.draw == 1) |> 
  ungroup() |> 
  group_by(.draw, Season) |> 
  summarise(i = which.max(.epred), dt = dt_num[i], NOx = .epred[i]) |> 
  dplyr::select(-i) |> 
  group_by(Season) |> 
  summarise_draws(median, HDInterval::hdi)

#the highest NOx value in the Dry season is 0.11 at 2013 but definitely somewhere between 2010-2017

#now get nicer looking dates
x |> 
  ungroup() |> 
  group_by(.draw, Season) |> 
  summarise(i = which.max(.epred), dt = dt_num[i], NOx = .epred[i]) |> 
  dplyr::select(-i) |> 
  group_by(Season) |> 
  dplyr::select(-NOx) |> 
  summarise_draws(median, HDInterval::hdi) |> 
  mutate(across(c(median, lower, upper), lubridate::date_decimal))
```


# Mixed effects models (all reefs)
```{r}
#| label: all reefs
#| eval: true
#| echo: true

#make a subset that just includes reefs with all years of data
wq_sub2 <- wq |> 
  group_by(Site) |> 
  mutate(Min = min(dt_num)) |> 
  ungroup() |> 
  filter(Min < 2012, Region != 'Fitzroy') |> 
  droplevels()

wq_form <- bf(NOx | cens(NOx_flag) ~
                gp(dt_num, k = 20, c = 5/4) + (1 | Site), family = Gamma(link = "log")) #added an approximation to speed up the model

get_prior(wq_form, data = wq_sub2)

priors <- prior(normal(-3.1, 1), class = "Intercept") +
  prior(gamma(0.01, 0.01), class = 'shape') +
  prior(inv_gamma(4.6, 0.4), class = 'lscale', coef = "gpdt_num") +
  prior(student_t(3, 0, 1), class = "sdgp") + #this is the amplitude --> how much the blue line is allowed to wobble
  prior(student_t(3, 0, 1), class = "sd")

wq_sub_brm6 <- brm(wq_form,
                  data = wq_sub2,
                  prior = priors,
                  sample_prior = 'yes',
                  iter = 3000,
                  warmup = 1000,
                  chains = 3, cores = 3,
                  thin = 5,
                  refresh = 100,
                  control = list(adapt_delta = 0.99, max_treedepth = 20),
                  backend = "cmdstanr",
                  seed = 123
                  )

wq_sub_brm6 |> 
  conditional_effects(effects = "dt_num") |> 
  plot(points = TRUE) |> 
  _[[1]] +
  scale_y_log10() +
  geom_point(data = wq_sub2, inherit.aes = FALSE,
             aes(y = NOx, x = dt_num))
```

```{r}
#| label: all reefs by region
#| eval: true
#| echo: true

wq_form <- bf(NOx | cens(NOx_flag) ~
                gp(dt_num, by = Region, k = 20, c = 5/4) + (1 | Site), family = Gamma(link = "log")) #added an approximation to speed up the model

get_prior(wq_form, data = wq_sub2)

priors <- prior(normal(-3.1, 1), class = "Intercept") +
  prior(gamma(0.01, 0.01), class = 'shape') +
  prior(inv_gamma(4.6, 0.4), class = 'lscale', coef = "gpdt_numRegionBurdekin") +
  prior(inv_gamma(4.6, 0.4), class = 'lscale', coef = "gpdt_numRegionMackayWhitsunday") +
  prior(inv_gamma(4.6, 0.4), class = 'lscale', coef = "gpdt_numRegionWetTropics") +
  prior(student_t(3, 0, 1), class = "sdgp") +
  prior(student_t(3, 0, 1), class = "sd")

wq_sub_brm7 <- brm(wq_form,
                  data = wq_sub2,
                  prior = priors,
                  sample_prior = 'yes',
                  iter = 3000,
                  warmup = 1000,
                  chains = 3, cores = 3,
                  thin = 5,
                  refresh = 100,
                  control = list(adapt_delta = 0.99, max_treedepth = 20),
                  backend = "cmdstanr",
                  seed = 123
                  )

wq_sub_brm7 |> 
  conditional_effects(effects = "dt_num:Region") |> 
  #plot(points = TRUE) |> 
  #_[[1]] +
  #scale_y_log10() +
  #geom_point(data = wq_sub, inherit.aes = FALSE,
             #aes(y = NOx, x = dt_num, color = Region))
  
```
# Look at month

```{r}
#| label: gam formula for reference
#| eval: true
#| echo: true

wq_form <- bf(NOx | cens(NOx_flag) ~ s(dt_num) +
                s(Mnth, bs = "cc") + # cc is for cubic cyclical smoother
                (1 | Site),
              family = Gamma(link = "log"))

```

```{r}
#| label: gp for month
#| eval: true
#| echo: true

#to detrend by month
wq_sub2 <- wq_sub2 |> 
  mutate(
    Mnth1 = cos(2 * pi * Mnth / 12),
    Mnth2 = sin(2 * pi * Mnth / 12)
  )

wq_form <- bf(NOx | cens(NOx_flag) ~ gp(dt_num, k = 20, c = 5/4) +
                gp(Mnth1, Mnth2, k = 20, c = 5/4) +
                (1 | Site),
              family = Gamma(link = "log"))

get_prior(wq_form, data = wq_sub2)

priors <- prior(normal(-3.1, 1), class = "Intercept") +
  prior(gamma(0.01, 0.01), class = 'shape') +
  prior(inv_gamma(4.6, 0.4), class = 'lscale', coef = "gpdt_num") +
  prior(inv_gamma(4.6, 0.4), class = 'lscale', coef = "gpMnth1Mnth2") +
  prior(student_t(3, 0, 1), class = "sdgp") +
  prior(student_t(3, 0, 1), class = "sd")

wq_sub_brm8 <- brm(wq_form,
                  data = wq_sub2,
                  prior = priors,
                  sample_prior = 'yes',
                  iter = 3000,
                  warmup = 1000,
                  chains = 3, cores = 3,
                  thin = 5,
                  refresh = 100,
                  control = list(adapt_delta = 0.99, max_treedepth = 20),
                  backend = "cmdstanr",
                  seed = 123
                  )

wq_sub_brm8 |> 
  conditional_effects(effects = "dt_num:Region") |> 
```

```{r}
#| label: predict data
#| eval: true
#| echo: true

newdata <- data.frame(Mnth = seq(1, 12, len = 100), dt_num = c(2005, 2014)) |> 
  mutate(Mnth1 = cos(2 * pi * Mnth / 12),
         Mnth2 = sin(2 *pi * Mnth / 12),
         Site = NA)

head(newdata)

wq_sub_brm8 |> 
  epred_draws(newdata = newdata, re_formula = NA) |> 
  ungroup() |> 
  dplyr::select(Mnth, dt_num, .epred) |> 
  group_by(Mnth, dt_num) |> 
  summarise_draws(median, HDInterval::hdi)

#plot
wq_sub_brm8 |> 
  epred_draws(newdata = newdata, re_formula = NA) |> 
  ungroup() |> 
  dplyr::select(Mnth, dt_num, .epred) |> 
  group_by(Mnth, dt_num) |> 
  summarise_draws(median, HDInterval::hdi) |> 
  ggplot(aes(y = median, x = Mnth)) +
  geom_ribbon(aes(ymin = lower, ymax = upper), 
              fill = "blue", 
              alpha = 0.3) +
  geom_line() +
  facet_grid(~dt_num)

```

# References

